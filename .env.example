# ============================================================
# GuardianMesh AI — Environment Configuration
# ============================================================

# Environment: development | production | test
APP_ENV=development
DEBUG=True

# Database Configuration (PostgreSQL in production, SQLite fallback in local)
DATABASE_URL=sqlite+aiosqlite:///./guardianmesh.db
# DATABASE_URL=postgresql+asyncpg://guardian_user:guardian_pass@localhost:5432/guardianmesh_db

# AWS Bedrock Configuration
# When AWS credentials are provided, AI_PROVIDER switches to 'bedrock'
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AI_PROVIDER=mock

# Ring Smart Home Provider Configuration
# Mode: 'simulator' | 'ring'
RING_MODE=simulator
RING_API_URL=https://api.ring.com
RING_ACCESS_TOKEN=
RING_REFRESH_TOKEN=

# Model Context Protocol (MCP) Server
MCP_PORT=8100
ALEXA_MODE=simulation

# Web App Ports
API_PORT=8000
WEB_PORT=5173
